APP_NAME="C-ECO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8019

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# adaptive | linear  -> penimpa global, jalur mundur L1 (aturan R10)
CAT_MODE=adaptive

# Dump basis data tiap 15 menit. Nyalakan di server pelaksanaan saja.
CAT_BACKUP_ENABLED=false
CAT_BACKUP_KEEP=48

DB_CONNECTION=mysql
# MariaDB native Ubuntu — sama seperti proyek lain di code_laranet
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_ceco
DB_USERNAME=app
DB_PASSWORD=app123

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# dump berkala selama jam pelaksanaan
BACKUP_INTERVAL_ENABLED=false
BACKUP_INTERVAL_MINUTES=15

VITE_APP_NAME="${APP_NAME}"
